          <cline>   for (int i = 0; i &lt; nums.length; i++)</cline>
          <cline>   {</cline>
        </choice>
      </block>

      <block order="8">
        <cline>       sum += nums.get(i);</cline>
      </block>

      <block order="6">
        <cline>   } //end for loop</cline>
      </block>

      <block order="2">
        <cline>   return (sum / nums.size());</cline>
      </block>

      <block order="7">
        <cline>} //end average method</cline>
      </block>
    </blocks>
  </activity>

