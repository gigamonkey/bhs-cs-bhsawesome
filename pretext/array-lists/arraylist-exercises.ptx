    <blocks>
      <block order="1">
        <cline>public static double average(ArrayList&lt;Integer&gt; nums)</cline>
        <cline>{</cline>
      </block>

      <block order="3">
        <cline>   double sum = 0;</cline>
      </block>

      <block order="5">
        <choice correct="yes">
          <cline>   for (int i = 0; i &lt; nums.size(); i++)</cline>
          <cline>   {</cline>
        </choice>

