  <activity label="parallelArrayLists">
    <statement>
      <p>
        Complete the code below to add the items in parallel ArrayLists to
        total.
      </p>
    </statement>

    <program interactive="activecode">

      <code>
        <![CDATA[
        import java.util.*;

        public class ParallelTests
        {
            public static void main(String[] args)
            {
                ArrayList<Integer> test1Grades = new ArrayList<Integer>();
                ArrayList<Integer> test2Grades = new ArrayList<Integer>();
                test1Grades.add(100);
                test2Grades.add(100);
                test1Grades.add(80);
                test2Grades.add(70);
                test1Grades.add(70);
                test2Grades.add(90);
                double total = 0;
                // Write 1 indexed for loop that adds
                // test1Grades and test2Grades at index i to total



                int numberOfGrades = test1Grades.size() * 2;
                System.out.println("Average over two tests: " + total / numberOfGrades);
            }
        }
        ]]>
      </code>

    </program>
  </activity>
</subsection>
