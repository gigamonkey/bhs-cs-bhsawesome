              private String message; // To be initialized in part (a)
              private int numWords; // To be initialized in part (a)

              /**
               * Part A: MessageBuilder(startingWord) constructor Builds a message of words with spaces in
               * between starting with the word in the parameter and counts the number of words in the
               * message. Precondition: startingWord is a single word with no spaces.
               */
              public MessageBuilder(String startingWord) {
                  // WRITE YOUR CODE HERE

              }

