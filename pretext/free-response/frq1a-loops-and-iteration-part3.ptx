              (implementation not shown in AP exam)
              */

              public String getNextWord(String s) {
                  if (currentWordIndex < wordsForTesting.length - 1) {
                      currentWordIndex++;
                      return wordsForTesting[currentWordIndex];
                  } else {
                      return null;
                  }
              }

