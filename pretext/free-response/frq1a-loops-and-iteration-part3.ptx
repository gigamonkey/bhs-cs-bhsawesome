            }

            /* There may be instance variables, constructors, and methods that are not shown. */
        }
        ]]>
      </code>

    </program>

    <activity label="FRQ-25-DogWalker-PartB">
      <statement>
        <p>
          Write the dogWalkShift method, which performs a dog-walking shift of
          the hours in the range startHour to endHour, inclusive, and returns
          the total amount earned. For example, a dog-walking shift from 14 to
          16 is composed of three one-hour dog walks starting at hours 14, 15,
          and 16.
        </p>

        <p>
          For each hour, the base pay is $5 per dog walked plus a bonus of $3 if
          at least one of the following is true.
        </p>

        <ul>
          <li>maxDogs dogs are walked</li>

          <li>the walk occurs between the peak hours of 9 and 17, inclusive</li>
        </ul>

        <p>
          The following table shows an example of the calculated amount earned
          by walking dogs from hour 7 through hour 10, inclusive.
        </p>

        <figure align="center">
          <image source="FreeResponse/Figures/frq1a-part3-dogwalker-b-table.png" width="100%" />
        </figure>

        <p>
          Complete method dogWalkShift. Assume that walkDogs works as specified.
          You must use walkDogs appropriately to earn full credit.
        </p>
      </statement>

      <program interactive="activecode" language="java">

        <code>
          <![CDATA[
          public class DogWalker {
              /** The maximum number of dogs this walker can walk simultaneously per hour */
              private int maxDogs;

              /** The dog-walking company this dog walker is associated with */
              private DogWalkCompany company;

              /**
               * Performs an entire dog-walking shift and returns the amount earned, in dollars, as described
               * in part (b) Preconditions: 0 <= startHour <= endHour <= 23 maxDogs > 0
               */
              public int dogWalkShift(int startHour, int endHour) {
                  /* WRITE YOUR CODE HERE */

              }

              /* Do not change anything below this comment */

              /** Assigns max to maxDogs and comp to company Precondition: max > 0 */
              public DogWalker(int max, DogWalkCompany comp) {
                  maxDogs = max;
                  company = comp;
              }

              public static void main(String[] args) {
                  DogWalkCompany comp = new DogWalkCompany();

                  DogWalker walker1 = new DogWalker(3, comp);
                  DogWalker walker2 = new DogWalker(4, comp);
                  DogWalker walker3 = new DogWalker(5, comp);

                  int resultB1 = walker1.dogWalkShift(7, 10);
                  int resultB2 = walker2.dogWalkShift(3, 5);
                  int resultB3 = walker3.dogWalkShift(12, 17);

                  System.out.println("Walker 1 should earn 59: " + resultB1);
                  System.out.println("Walker 2 should earn 38: " + resultB2);
                  System.out.println("Walker 3 should earn 138: " + resultB3);
              }

              /**
               * Takes at least one dog for a walk during the time specified by hour, as described in part (a)
               * Preconditions: 0 <= hour <= 23 maxDogs > 0
               */
              public int walkDogs(int hour) {
                  if (dogs[hour] < maxDogs) return dogs[hour];
                  return maxDogs;
              }

              private int[] dogs =
                      new int[] {10, 3, 2, 2, 1, 5, 4, 3, 2, 2, 3, 1, 5, 4, 5, 2, 5, 3, 2, 1, 3, 3, 1, 5};
          }

          class DogWalkCompany {
              private int[] dogs;

              public DogWalkCompany() {
                  dogs = new int[] {10, 3, 2, 2, 1, 5, 4, 3, 2, 2, 3, 1, 5, 4, 5, 2, 5, 3, 2, 1, 3, 3, 1, 5};
              }

              /**
               * Returns the number of dogs, always greater than 0, that are available for a walk during the
               * time specified by hour Precondition: 0 <= hour <= 23
               */
              public int numAvailableDogs(int hour) {
                  return dogs[hour];
              }

              /**
               * Decreases, by numberDogsWalked, the number of dogs available for a walk during the time
               * specified by hour Preconditions: 0 <= hour <= 23 numberDogsWalked > 0
               */
              public void updateDogs(int hour, int numberDogsWalked) {
                  dogs[hour] -= numberDogsWalked;
              }

              /* There may be instance variables, constructors, and methods that are not shown. */
          }
          ]]>
        </code>

      </program>
    </activity>
