<?xml version="1.0" encoding="utf-8"?>

<pretext xml:lang="en-US" xmlns:xi="http://www.w3.org/2001/XInclude">
  <docinfo>
    <document-id>BHSawesome2</document-id>

    <blurb shelf="AP Computer Science">
      BHSawesome2 is a AP CSA textbook adapted from CSAwesome2 for use at
      Berkeley High School in Berkeley, California. It follow the latest (2025)
      revision of the AP Computer Science A Course and Exam Description but
      presents the material in a somewhat different order than CSAwesome2 and
      does not attempt to mirror the unit and topic structure of the College
      Board Course and Exam Description. If you want a text whose units and
      topic numbers line up exactly with those in the College Board outline, you
      will want to use CSAwesome2.
    </blurb>

    <rename element="inlineexercise">Activity</rename>

    <brandlogo url="./bhsawesome.html" source="_static/BHSawesomeLogo.png" alt="BHSawesome" />
    <cross-references text="type-global-title" />
    <programs language="java" />
    <parsons language="java" />
  </docinfo>

  <book xml:id="bhsawesome">
    <title>BHSawesome</title>

    <subtitle>AP CSA</subtitle>

    <xi:include href="./frontmatter/toctree.ptx" />
    <xi:include href="./introduction/toctree.ptx" />
    <xi:include href="./primitive-types-and-variables/toctree.ptx" />
    <xi:include href="./methods/toctree.ptx" />
    <xi:include href="./booleans-and-conditionals/toctree.ptx" />
    <xi:include href="./loops/toctree.ptx" />
    <xi:include href="./arrays/toctree.ptx" />
    <xi:include href="./strings/toctree.ptx" />
    <xi:include href="./classes/toctree.ptx" />
    <xi:include href="./objects/toctree.ptx" />
    <xi:include href="./array-lists/toctree.ptx" />
    <xi:include href="./text-files/toctree.ptx" />
    <xi:include href="./algorithms/toctree.ptx" />
    <xi:include href="./abstraction-and-program-design/toctree.ptx" />
    <xi:include href="./ap-practice/toctree.ptx" />
    <xi:include href="./free-response/toctree.ptx" />
    <backmatter xml:id="backmatter">
      <index xml:id="book-index">
        <index-list />
      </index>

      <colophon xml:id="colophon">
        <p>
          BHSawesome was originally hosted on <url
          href="https://runestone.academy">Runestone Academy</url> and written
          in the <url href="https://pretextbook.org">PreTeXt</url> markup
          language. In the summer of 2026 we moved it to be hosted on the <url
          href="https://bhs-cs.gigamonkeys.com">bhs-cs.gigamonkeys.com</url>
          website and built tooling to build it from the original PreTeXt
          sources without all the generality of full PreTeXt.
        </p>

        <p>
          Mathematical notation in this book is provided via <url
          href="https://www.mathjax.org">MathJax</url>, code highlighting via
          <url href="https://prismjs.com">Prism</url>, and code editing via <url
          href="https://codemirror.net">CodeMirror6</url>.
        </p>

        <p>
          Interactive exercises other than the Java code problems are built on
          Runestone's <url
          href="https://github.com/RunestoneInteractive/rs">component
          library</url>; CodeLens visualizations are powered by Philip Guo's
          <url href="https://pythontutor.com">Online Python Tutor</url> and
          David Pritchard's <url
          href="https://github.com/daveagp/java_jail">Java tracer</url>; and
          search is powered by <url href="https://lunrjs.com">Lunr</url>.
        </p>
      </colophon>
    </backmatter>

    <conclusion>
      <p>
        If you see errors or bugs, please email <url
        href="mailto:peterseibel@berkeley.net">peterseibel@berkeley.net</url>.
      </p>
    </conclusion>
  </book>
</pretext>
